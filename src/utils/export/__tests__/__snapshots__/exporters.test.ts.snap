"import React from 'react';
import { render, Box, Text } from 'ink';
import TextInput from 'ink-text-input';
import SelectInput from 'ink-select-input';
import Spinner from 'ink-spinner';

function App() {
  return (
    <Box>
      <Box flexDirection="row" gap={2} padding={1} borderStyle="single" borderColor="#414868">
        <Text color="#7dcfff" bold>Say "hi" to &lt;all&gt;</Text>
        <Box flexDirection="row">
          <Text key={"Dashboard"} underline> Dashboard </Text>
          <Text key={"Agent"} underline> Agent </Text>
        </Box>
      </Box>
      <Box flexDirection="row">
        {/* onSelect ("handleFileSelect") not wired — no prop for this on a plain <Text>/<Box>; see useInput for real keyboard handling */}
        {/* onKeyPress ("handleFzfKeys") not wired — no prop for this on a plain <Text>/<Box>; see useInput for real keyboard handling */}
        <Box borderStyle="single" borderColor="red" flexDirection="column">
          <Text key={"main.rs-0"}>[x] • main.rs</Text>
          <Text key={"lib.rs-1"}>[ ] • lib.rs</Text>
        </Box>
        <Box flexDirection="column">
          <Text key={"Root"}>{"Root"}</Text>
          <Text key={"  ├─ Child 1"}>{"  ├─ Child 1"}</Text>
          <Text key={"  ├─ Child 2"}>{"  ├─ Child 2"}</Text>
          <Text key={"    ├─ Nested"}>{"    ├─ Nested"}</Text>
        </Box>
        {/* onKeyPress ("handleTableKeys") not wired — no prop for this on a plain <Text>/<Box>; see useInput for real keyboard handling */}
        <Box flexDirection="column">
          <Text key={0}>{"PID            │ CPU           "}</Text>
          <Text key={1}>{"───────────────┼───────────────"}</Text>
          <Text key={2}>{"123            │ 45%           "}</Text>
          <Text key={3}>{"456            │ 2%            "}</Text>
        </Box>
        <Box flexDirection="column" gap={1}>
          <Text key={"Home"}>⌂ Home</Text>
        </Box>
      </Box>
      <Box>
        {/* onClick ("handleOk") not wired — no prop for this on a plain <Text>/<Box>; see useInput for real keyboard handling */}
        <Text bold inverse>  OK  </Text>
        <Text color="red" bold inverse>  Cancel  </Text>
        <TextInput value={""} placeholder={"type \\"here\\"..."} onChange={() => handleSearchChange()} />
        {/* onChange ("handleNotesChange") not wired — no prop for this on a plain <Text>/<Box>; see useInput for real keyboard handling */}
        <Box flexDirection="column">
          <Text key={0}>Line one</Text>
          <Text key={1}>Line two</Text>
          <Text key={2}></Text>
        </Box>
        {/* onChange ("handleOptChange") not wired — no prop for this on a plain <Text>/<Box>; see useInput for real keyboard handling */}
        <Text>{/* checked={true} */} ✓ Enable</Text>
        {/* onChange ("handleR1Change") not wired — no prop for this on a plain <Text>/<Box>; see useInput for real keyboard handling */}
        <Text>{/* selected={true} */} ◉ Choice A</Text>
        {/* onChange ("handleDarkChange") not wired — no prop for this on a plain <Text>/<Box>; see useInput for real keyboard handling */}
        <Text>{/* on={true} */} {true ? '[ON ]' : '[OFF]'} Dark mode</Text>
        <SelectInput items={[{ label: "One", value: "one" }, { label: "Two", value: "two" }]} onSelect={() => handleSelChange()} />
        <Text><Spinner type="bouncingBar" /> Working</Text>
        <Text>
          {"["}{'='.repeat(Math.round(67 / 100 * 24))}{' '.repeat(24 - Math.round(67 / 100 * 24))}{"]"} 67%
        </Text>
        <Text>{"████████CPU 42%░░░░░░░░░"}</Text>
        <Text>{"▁▂▂▄▃▆▅▇▆█"}</Text>
        <Box flexDirection="column">
          <Text key={0}>Starting up...</Text>
          <Text key={1}>Connected</Text>
          <Text key={2}>200 OK</Text>
        </Box>
        <Text>{"^Q Quit  ^S Save"}</Text>
        <Text>{"Home  /  Docs"}</Text>
        <Text>{"✓ Saved successfully"}</Text>
        <Box flexGrow={1} />
        <Text>{"════════════════════"}</Text>
      </Box>
      <Box borderStyle="single" />
      <Box borderStyle="double" borderColor="red">
        <Text>Sure?</Text>
      </Box>
    </Box>
  );
}

render(<App />);

// Install extra packages:
// npm install ink-text-input ink-select-input ink-spinner
"
`;

