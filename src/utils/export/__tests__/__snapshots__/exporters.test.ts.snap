exports[`exportToCode snapshots > ratatui: kitchen-sink tree 1`] = `
"// Requires: ratatui = "0.28"
// Add to Cargo.toml: [dependencies] ratatui = { version = "0.28", features = ["crossterm"] }
use std::io;
use ratatui::{
    crossterm::event::{self, Event, KeyCode, KeyEventKind},
    layout::{Alignment, Constraint, Direction, Layout, Rect},
    style::{Color, Modifier, Style},
    text::Line,
    widgets::{Block, BorderType, Borders, Gauge, List, ListItem, Paragraph, Row, Sparkline, Table, Tabs},
    Frame,
};

fn main() -> io::Result<()> {
    let mut terminal = ratatui::init();
    let mut focus_index: usize = 0;
    loop {
        terminal.draw(ui)?;
        if let Event::Key(key) = event::read()? {
            if key.kind == KeyEventKind::Press {
                match key.code {
                    KeyCode::Char('q') | KeyCode::Esc => break,
                    KeyCode::Tab => { focus_index = (focus_index + 1) % 12; },
                    KeyCode::BackTab => { focus_index = (focus_index + 12 - 1) % 12; },
                    _ => {
                match focus_index {
                    0 => {}, // Nav
                    1 => handleFzfKeys(), // Files
                    2 => {}, // Explorer
                    3 => handleTableKeys(), // Stats
                    4 => {}, // Nav2
                    5 => {}, // OK
                    6 => {}, // OK
                    7 => {}, // Search
                    8 => {}, // Notes
                    9 => {}, // Opt
                    10 => {}, // R1
                    11 => {}, // Sel
                    _ => {}
                }
                    }
                }
            }
        }
    }
    ratatui::restore();
    Ok(())
}

