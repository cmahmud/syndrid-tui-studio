exports[`style edge cases (gradient fallback, justify/align/gap) > ratatui: style edge cases tree (truecolor) 1`] = `
"// Requires: ratatui = "0.28"
// Add to Cargo.toml: [dependencies] ratatui = { version = "0.28", features = ["crossterm"] }
use std::io;
use ratatui::{
    crossterm::event::{self, Event, KeyCode, KeyEventKind},
    layout::{Alignment, Constraint, Direction, Layout, Rect},
    style::{Color, Modifier, Style},
    widgets::{Block, BorderType, Borders, Paragraph},
    Frame,
};

fn main() -> io::Result<()> {
    let mut terminal = ratatui::init();
    loop {
        terminal.draw(ui)?;
        if let Event::Key(key) = event::read()? {
            if key.kind == KeyEventKind::Press {
                match key.code {
                    KeyCode::Char('q') | KeyCode::Esc => break,
                    _ => {
                    }
                }
            }
        }
    }
    ratatui::restore();
    Ok(())
}

fn ui(frame: &mut Frame) {
    let area = frame.area();
    let chunks_area = Layout::default()
        .direction(Direction::Vertical)
        .constraints([Constraint::Min(1), Constraint::Min(1), Constraint::Min(1)])
        .split(area);
        let block_chunks_area_0_ = Block::new().style(Style::default().bg(Color::Rgb(255, 0, 0)));
        let inner_chunks_area_0_ = block_chunks_area_0_.inner(chunks_area[0]);
        frame.render_widget(block_chunks_area_0_, chunks_area[0]);
        let chunks_chunks_area_1_ = Layout::default()
            .direction(Direction::Horizontal)
            .constraints([Constraint::Fill(1), Constraint::Min(1), Constraint::Min(1), Constraint::Fill(1)])
            .spacing(3)
            .split(chunks_area[1]);
            frame.render_widget(Paragraph::new("A").style(Style::default().fg(Color::Rgb(136, 0, 0))), chunks_chunks_area_1_[1]);
            frame.render_widget(Paragraph::new("B").style(Style::default().fg(Color::LightGreen)), chunks_chunks_area_1_[2]);
        let chunks_chunks_area_2_ = Layout::default()
            .direction(Direction::Vertical)
            .constraints([Constraint::Min(1), Constraint::Fill(1), Constraint::Min(1)])
            .split(chunks_area[2]);
            frame.render_widget(Paragraph::new("C").style(Style::default()), chunks_chunks_area_2_[0]);
            frame.render_widget(Paragraph::new("D").style(Style::default()), chunks_chunks_area_2_[2]);

}
"
`;

exports[`style edge cases (gradient fallback, justify/align/gap) > textual: style edge cases tree (truecolor) 1`] = `
"from textual.app import App, ComposeResult
from textual.containers import Horizontal, Vertical
from textual.widgets import Static


class MyApp(App):
    CSS = """
    #banner {
        background: #ff0000;
    }

    #centeredrow > * {
        margin-right: 3;
    }

    #a {
        color: #800;
    }

    #b {
        color: ansi_bright_green;
    }
    """

    def compose(self) -> ComposeResult:
        with Vertical(id="banner"):
            pass
        with Horizontal(id="centeredrow"):
            yield Static("A", id="a")
            yield Static("B", id="b")
        with Vertical():
            yield Static("C")
            yield Static("D")


if __name__ == "__main__":
    MyApp().run()
"
`;

