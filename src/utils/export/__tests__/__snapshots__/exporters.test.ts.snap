	opt.SetChangedFunc(func(checked bool) { handleOptChange() })
	controls.AddItem(opt, 2, 0, 1, 1, 0, 0, false)
	r1 := tview.NewCheckbox()
	r1.SetLabel(tview.Escape("Choice A "))
	r1.SetChecked(true)
	r1.SetCheckedString(tview.Escape("●"))
	r1.SetUncheckedString(tview.Escape("○"))
	r1.SetChangedFunc(func(checked bool) { handleR1Change() })
	controls.AddItem(r1, 2, 1, 1, 1, 0, 0, false)
	dark := tview.NewCheckbox()
	dark.SetLabel(tview.Escape("Dark mode "))
	dark.SetChecked(true)
	dark.SetCheckedString(tview.Escape(" ON "))
	dark.SetUncheckedString(tview.Escape(" OFF "))
	dark.SetChangedFunc(func(checked bool) { handleDarkChange() })
	controls.AddItem(dark, 3, 0, 1, 1, 0, 0, false)
	sel := tview.NewDropDown()
	sel.SetOptions([]string{tview.Escape("One"), tview.Escape("Two")}, nil)
	sel.SetCurrentOption(1)
	sel.SetSelectedFunc(func(text string, index int) { handleSelChange() })
	controls.AddItem(sel, 3, 1, 1, 1, 0, 0, false)
	load := tview.NewTextView()
	load.SetText(tview.Escape("[====] Working")) // static frame; drive with a time.Ticker + app.QueueUpdateDraw for a live spinner
	controls.AddItem(load, 4, 0, 1, 1, 0, 0, false)
	prog := tview.NewTextView()
	prog.SetText(tview.Escape("[==========>      ] 67%")) // tview has no built-in progress bar; update this text as work completes
	controls.AddItem(prog, 4, 1, 1, 1, 0, 0, false)
	cPU := tview.NewTextView()
	cPU.SetText(tview.Escape("████████CPU 42%░░░░░░░░░")) // tview has no built-in gauge; update this text as the value changes
	controls.AddItem(cPU, 5, 0, 1, 1, 0, 0, false)
	trend := tview.NewTextView()
	trend.SetText(tview.Escape("▁▂▂▄▃▆▅▇▆█")) // tview has no built-in sparkline; update this text as data changes
	controls.AddItem(trend, 5, 1, 1, 1, 0, 0, false)
	output := tview.NewTextView()
	output.SetScrollable(true)
	output.SetText(tview.Escape("Starting up...\\nConnected\\n200 OK"))
	output.ScrollToEnd()
	controls.AddItem(output, 6, 0, 1, 1, 0, 0, false)
	footer := tview.NewTextView()
	footer.SetText(tview.Escape("^Q Quit  ^S Save"))
	controls.AddItem(footer, 6, 1, 1, 1, 0, 0, false)
	crumb := tview.NewTextView()
	crumb.SetText(tview.Escape("Home / Docs"))
	controls.AddItem(crumb, 7, 0, 1, 1, 0, 0, false)
	notice := tview.NewTextView()
	notice.SetText(tview.Escape("✓ Saved successfully"))
	controls.AddItem(notice, 7, 1, 1, 1, 0, 0, false)
	controls.AddItem(tview.NewBox(), 8, 0, 1, 1, 0, 0, false)
	div := tview.NewTextView()
	div.SetText(tview.Escape("════════════════════"))
	controls.AddItem(div, 8, 1, 1, 1, 0, 0, false)
	root.AddItem(controls, 0, 1, false)
	empty := tview.NewFlex()
	empty.SetDirection(tview.FlexRow)
	empty.SetBorder(true)
	empty.SetTitle(tview.Escape(" Empty "))
	root.AddItem(empty, 0, 1, false)
	confirm := tview.NewFlex()
	confirm.SetDirection(tview.FlexRow)
	msg := tview.NewTextView()
	msg.SetText(tview.Escape("Sure?"))
	confirm.AddItem(msg, 0, 1, false)
	confirm.SetBorder(true)
	confirm.SetBorderColor(tcell.GetColor("red"))
	confirm.SetTitle(tview.Escape(" Confirm "))
	confirmModal := tview.NewGrid()
	confirmModal.SetRows(0, 12, 0)
	confirmModal.SetColumns(0, 40, 0)
	confirmModal.AddItem(confirm, 1, 1, 1, 1, 0, 0, false)
	pages := tview.NewPages()
	pages.AddPage("main", root, true, true)
	pages.AddPage("modal-confirm", confirmModal, true, true)

	app.SetInputCapture(func(event *tcell.EventKey) *tcell.EventKey {
		if event.Key() == tcell.KeyEscape || event.Rune() == 'q' {
			app.Stop()
		}
		return event
	})

	if err := app.SetRoot(pages, true).Run(); err != nil {
		panic(err)
	}
}

