            .direction(Direction::Horizontal)
            .constraints([Constraint::Min(1), Constraint::Min(1)])
            .spacing(2)
            .split(inner_chunks_area_0_);
            frame.render_widget(Paragraph::new("Say \\"hi\\" to <all>").style(Style::default().fg(Color::Rgb(125, 207, 255)).add_modifier(Modifier::BOLD)), chunks_inner_chunks_area_0_[0]);
            frame.render_widget(Tabs::new(vec!["Dashboard", "Agent"]).select(1).style(Style::default()).highlight_style(Style::default().add_modifier(Modifier::BOLD)), chunks_inner_chunks_area_0_[1]);
