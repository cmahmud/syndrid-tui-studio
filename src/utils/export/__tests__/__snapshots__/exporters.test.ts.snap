exports[`exportToCode snapshots > bubbletea: empty screen 1`] = `
"package main

import (
	"fmt"
	"os"

	tea "github.com/charmbracelet/bubbletea"
	"github.com/charmbracelet/lipgloss"
)

type model struct{}

func (m model) Init() tea.Cmd {
	return nil
}

func (m model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	switch msg := msg.(type) {
	case tea.KeyMsg:
		if msg.String() == "ctrl+c" || msg.String() == "q" {
			return m, tea.Quit
		}
	}
	return m, nil
}

func (m model) View() string {
	return ""
}

func main() {
	p := tea.NewProgram(model{}, tea.WithAltScreen())
	if _, err := p.Run(); err != nil {
		fmt.Println("Error:", err)
		os.Exit(1)
	}
}
"
`;

exports[`exportToCode snapshots > bubbletea: kitchen-sink tree 1`] = `
"// NOT exported (unsupported in a static view):
//   - Modal "Confirm" — no overlay support; build with tea.Model state + lipgloss.Place

package main

import (
	"fmt"
	"os"

	tea "github.com/charmbracelet/bubbletea"
	"github.com/charmbracelet/lipgloss"
)

type model struct{}

func (m model) Init() tea.Cmd {
	return nil
}

func (m model) Update(msg tea.Msg) (tea.Model, tea.Cmd) {
	switch msg := msg.(type) {
	case tea.KeyMsg:
		if msg.String() == "ctrl+c" || msg.String() == "q" {
			return m, tea.Quit
		}
	}
	return m, nil
}

func (m model) View() string {
	nav := lipgloss.JoinHorizontal(lipgloss.Top, " Dashboard ", lipgloss.NewStyle().Bold(true).Underline(true).Render(" Agent "))
	header := lipgloss.NewStyle().Border(lipgloss.RoundedBorder()).BorderForeground(lipgloss.Color("#414868")).Padding(1).Render(lipgloss.JoinHorizontal(lipgloss.Top, lipgloss.NewStyle().Foreground(lipgloss.Color("#7dcfff")).Bold(true).Render("Say \\"hi\\" to <all>"), "  ", nav))
	// onSelect ("handleFileSelect") not wired: this is a static View(), rebuild with a real tea.Model/Update() to handle it
	// onKeyPress ("handleFzfKeys") not wired: this is a static View(), rebuild with a real tea.Model/Update() to handle it
	// onKeyPress ("handleTableKeys") not wired: this is a static View(), rebuild with a real tea.Model/Update() to handle it
	body := lipgloss.JoinHorizontal(lipgloss.Top, lipgloss.NewStyle().Border(lipgloss.NormalBorder()).BorderForeground(lipgloss.Color("1")).Render("▶ [x] • main.rs  1\\n  [ ] • lib.rs  2"), "Root\\n  ├─ Child 1\\n  ├─ Child 2\\n    ├─ Nested", "PID            │ CPU           \\n───────────────┼───────────────\\n123            │ 45%           \\n456            │ 2%            ", "  ⌂ Home  ^H")
	// onClick ("handleOk") not wired: this is a static View(), rebuild with a real tea.Model/Update() to handle it
	// onChange ("handleSearchChange") not wired: this is a static View(), rebuild with a real tea.Model/Update() to handle it
	// onChange ("handleNotesChange") not wired: this is a static View(), rebuild with a real tea.Model/Update() to handle it
	// onChange ("handleOptChange") not wired: this is a static View(), rebuild with a real tea.Model/Update() to handle it
	// onChange ("handleR1Change") not wired: this is a static View(), rebuild with a real tea.Model/Update() to handle it
	// onChange ("handleDarkChange") not wired: this is a static View(), rebuild with a real tea.Model/Update() to handle it
	// onChange ("handleSelChange") not wired: this is a static View(), rebuild with a real tea.Model/Update() to handle it
	controls := lipgloss.JoinVertical(lipgloss.Left, lipgloss.JoinHorizontal(lipgloss.Top, lipgloss.NewStyle().Bold(true).Reverse(true).Render(" OK "), lipgloss.NewStyle().Bold(true).Reverse(true).Foreground(lipgloss.Color("1")).Render(" Cancel ")), lipgloss.JoinHorizontal(lipgloss.Top, "type \\"here\\"..._", lipgloss.NewStyle().Height(3).Render("Line one\\nLine two\\n")), lipgloss.JoinHorizontal(lipgloss.Top, "[✓] Enable", "(●) Choice A"), lipgloss.JoinHorizontal(lipgloss.Top, "[ON ] Dark mode", "Two ▼"), lipgloss.JoinHorizontal(lipgloss.Top, "[====] Working", "[==========>      ] 67%"), lipgloss.JoinHorizontal(lipgloss.Top, lipgloss.NewStyle().Width(24).Render("████████CPU 42%░░░░░░░░░"), lipgloss.NewStyle().Width(10).Render("▁▂▂▄▃▆▅▇▆█")), lipgloss.JoinHorizontal(lipgloss.Top, lipgloss.NewStyle().Width(20).Height(3).Render("Starting up...\\nConnected\\n200 OK"), "^Q Quit  ^S Save"), lipgloss.JoinHorizontal(lipgloss.Top, "Home / Docs", "✓ Saved successfully"), lipgloss.JoinHorizontal(lipgloss.Top, "", "════════════════════"))
	empty := lipgloss.NewStyle().Border(lipgloss.NormalBorder()).Render("")
	screen := lipgloss.JoinVertical(lipgloss.Left, header, body, controls, empty)
	return screen
}

func main() {
	p := tea.NewProgram(model{}, tea.WithAltScreen())
	if _, err := p.Run(); err != nil {
		fmt.Println("Error:", err)
		os.Exit(1)
	}
}
"
`;

