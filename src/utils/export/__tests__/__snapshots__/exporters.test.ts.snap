"package main

import (
	"github.com/gdamore/tcell/v2"
	"github.com/rivo/tview"
)

func main() {
	app := tview.NewApplication()

	root := tview.NewFlex()
	root.SetDirection(tview.FlexRow)
	banner := tview.NewFlex()
	banner.SetDirection(tview.FlexRow)
	banner.SetBackgroundColor(tcell.GetColor("#ff0000"))
	root.AddItem(banner, 0, 1, false)
	centeredRow := tview.NewFlex()
	centeredRow.SetDirection(tview.FlexColumn)
	a := tview.NewTextView()
	a.SetText(tview.Escape("A"))
	a.SetTextColor(tcell.GetColor("#800"))
	centeredRow.AddItem(a, 0, 1, false)
	b := tview.NewTextView()
	b.SetText(tview.Escape("B"))
	b.SetTextColor(tcell.PaletteColor(10))
	centeredRow.AddItem(tview.NewBox(), 3, 0, false)
	centeredRow.AddItem(b, 0, 1, false)
	root.AddItem(centeredRow, 0, 1, false)
	spacedColumn := tview.NewFlex()
	spacedColumn.SetDirection(tview.FlexRow)
	c := tview.NewTextView()
	c.SetText(tview.Escape("C"))
	spacedColumn.AddItem(c, 0, 1, false)
	d := tview.NewTextView()
	d.SetText(tview.Escape("D"))
	spacedColumn.AddItem(d, 0, 1, false)
	root.AddItem(spacedColumn, 0, 1, false)

	app.SetInputCapture(func(event *tcell.EventKey) *tcell.EventKey {
		if event.Key() == tcell.KeyEscape || event.Rune() == 'q' {
			app.Stop()
		}
		return event
	})

	if err := app.SetRoot(root, true).Run(); err != nil {
		panic(err)
	}
}
"
`;
