"package main

import (
	"github.com/gdamore/tcell/v2"
	"github.com/rivo/tview"
)

func main() {
	app := tview.NewApplication()

	root := tview.NewFlex()
	root.SetDirection(tview.FlexRow)
	header := tview.NewFlex()
	header.SetDirection(tview.FlexColumn)
	title := tview.NewTextView()
	title.SetText(tview.Escape("Say \\"hi\\" to <all>"))
	title.SetTextColor(tcell.GetColor("#7dcfff"))
	header.AddItem(title, 0, 1, false)
	nav := tview.NewTextView()
	nav.SetText(tview.Escape("  Dashboard  [ Agent ]")) // static preview; build real tabs with a Flex of Buttons + tview.Pages
	header.AddItem(tview.NewBox(), 2, 0, false)
	header.AddItem(nav, 0, 1, false)
	header.SetBorder(true)
	header.SetBorderColor(tcell.GetColor("#414868"))
	header.SetTitle(tview.Escape(" Header "))
	root.AddItem(header, 0, 1, false)
	body := tview.NewFlex()
	body.SetDirection(tview.FlexColumn)
	files := tview.NewList()
	files.ShowSecondaryText(false)
	files.AddItem(tview.Escape("[x] • main.rs  1"), "", 0, nil)
	files.AddItem(tview.Escape("[ ] • lib.rs  2"), "", 0, nil)
	files.SetCurrentItem(0)
	files.SetSelectedFunc(func(index int, mainText, secondaryText string, shortcut rune) { handleFileSelect() })
	files.SetInputCapture(func(event *tcell.EventKey) *tcell.EventKey { handleFzfKeys(); return event })
	files.SetBorder(true)
	files.SetBorderColor(tcell.GetColor("red"))
	files.SetTitle(tview.Escape(" Files "))
	body.AddItem(files, 0, 1, false)
	explorerNode := tview.NewTreeNode(tview.Escape("Root"))
	explorerNode.SetExpanded(true)
	explorerNode2 := tview.NewTreeNode(tview.Escape("Child 1"))
	explorerNode2.SetExpanded(false)
	explorerNode.AddChild(explorerNode2)
	explorerNode3 := tview.NewTreeNode(tview.Escape("Child 2"))
	explorerNode3.SetExpanded(false)
	explorerNode4 := tview.NewTreeNode(tview.Escape("Nested"))
	explorerNode4.SetExpanded(false)
	explorerNode3.AddChild(explorerNode4)
	explorerNode.AddChild(explorerNode3)
	explorer := tview.NewTreeView()
	explorer.SetRoot(explorerNode)
	explorer.SetCurrentNode(explorerNode)
	body.AddItem(explorer, 0, 1, false)
	stats := tview.NewTable()
	stats.SetCell(0, 0, tview.NewTableCell(tview.Escape("PID")))
	stats.SetCell(0, 1, tview.NewTableCell(tview.Escape("CPU")))
	stats.SetCell(1, 0, tview.NewTableCell(tview.Escape("123")))
	stats.SetCell(1, 1, tview.NewTableCell(tview.Escape("45%")))
	stats.SetCell(2, 0, tview.NewTableCell(tview.Escape("456")))
	stats.SetCell(2, 1, tview.NewTableCell(tview.Escape("2%")))
	stats.SetInputCapture(func(event *tcell.EventKey) *tcell.EventKey { handleTableKeys(); return event })
	body.AddItem(stats, 0, 1, false)
	nav2 := tview.NewList()
