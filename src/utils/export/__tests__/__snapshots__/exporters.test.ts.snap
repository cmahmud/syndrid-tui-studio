exports[`exportToCode snapshots > textual: kitchen-sink tree 1`] = `
"from textual.app import App, ComposeResult
from textual import events
from textual.containers import Grid, Horizontal, Vertical
from textual.screen import ModalScreen
from textual.widgets import Button, Checkbox, DataTable, Footer, Input, LoadingIndicator, OptionList, ProgressBar, RadioButton, RichLog, Rule, Select, SelectionList, Sparkline, Static, Switch, Tabs, TextArea, Tree


class ConfirmModal(ModalScreen):
    def compose(self) -> ComposeResult:
        with Vertical(id="confirm"):
            yield Static("Sure?")


class MyApp(App):
    BINDINGS = [
        ("ctrl+q", "quit", "Quit"),
        ("ctrl+s", "save", "Save"),
    ]

    CSS = """
    #header {
        border: round #414868;
        padding: 1;
    }

    #header > * {
        margin-right: 2;
    }

    #title {
        color: #7dcfff;
        text-style: bold;
    }

    #body {
        width: 1fr;
    }

    #files {
        border: solid ansi_red;
    }

    #controls {
        grid-size: 2 9;
    }

    #ok {
        color: ansi_red;
    }

    #notes {
        height: 3;
    }

    #prog {
        width: 24;
    }

    #cpu {
        width: 24;
    }

    #trend {
        width: 10;
    }

    #output {
        width: 20;
        height: 3;
    }

    #empty {
        border: solid ansi_white;
    }

    #confirm {
        width: auto;
        height: auto;
        border: double ansi_red;
    }

    ConfirmModal {
        align: center middle;
    }

    .spacer {
        width: 1fr;
        height: 1fr;
    }
    """

    def compose(self) -> ComposeResult:
        with Horizontal(id="header"):
            yield Static("Say \\"hi\\" to <all>", id="title")
            yield Tabs("Dashboard", "Agent", id="nav")
        with Horizontal(id="body"):
            yield SelectionList(("main.rs", 0, True), ("lib.rs", 1, False), id="files")
            yield Tree("Explorer", id="explorer")
            yield DataTable(id="stats")
            yield OptionList("⌂ Home")
        with Grid(id="controls"):
            yield Button("OK")
            yield Button("Cancel", id="ok")
            yield Input(placeholder="type \\"here\\"...")
            yield TextArea("Line one\\nLine two", placeholder="Enter notes...", id="notes")
            yield Checkbox("Enable", value=True)
            yield RadioButton("Choice A", value=True)
            with Horizontal():
                yield Static("Dark mode")
                yield Switch(value=True)
            yield Select([("One", 0), ("Two", 1)], allow_blank=False, value=1)
            yield LoadingIndicator()
            yield ProgressBar(total=100, show_eta=False, id="prog")
            with Horizontal():
                yield Static("CPU")
                yield ProgressBar(total=100, show_eta=False, id="cpu")
            yield Sparkline([1, 3, 2, 5, 4, 8, 6, 9, 7, 10], summary_function=max, id="trend")
            yield RichLog(id="output")
            yield Footer()
            yield Static("Home / Docs")
            yield Static("", classes="spacer")
            yield Rule.horizontal(line_style="double")
        with Vertical(id="empty"):
            pass

    def on_mount(self) -> None:
        self.query_one("#nav", Tabs).active = "tab-2"
        tree_explorer = self.query_one("#explorer", Tree)
        tree_explorer.root.expand()
        node_explorer_0_0 = tree_explorer.root.add("Root", expand=True)
        node_explorer_0_0.add_leaf("Child 1")
        node_explorer_1_1 = node_explorer_0_0.add("Child 2", expand=False)
        node_explorer_1_1.add_leaf("Nested")
        table_stats = self.query_one("#stats", DataTable)
        table_stats.add_columns("PID", "CPU")
        table_stats.add_rows([("123", "45%"), ("456", "2%")])
        self.query_one("#prog", ProgressBar).update(total=100, progress=67)
        self.query_one("#cpu", ProgressBar).update(total=100, progress=42)
        self.query_one("#output", RichLog).write("Starting up...")
        self.query_one("#output", RichLog).write("Connected")
        self.query_one("#output", RichLog).write("200 OK")
        self.notify("Saved successfully", severity="information")
        self.push_screen(ConfirmModal())

    def on_button_pressed(self, event: Button.Pressed) -> None:
        self.handleOk()

    def on_input_changed(self, event: Input.Changed) -> None:
        self.handleSearchChange()

    def on_checkbox_changed(self, event: Checkbox.Changed) -> None:
        self.handleOptChange()

    def on_radio_button_changed(self, event: RadioButton.Changed) -> None:
        self.handleR1Change()

    def on_switch_changed(self, event: Switch.Changed) -> None:
        self.handleDarkChange()

    def on_select_changed(self, event: Select.Changed) -> None:
        self.handleSelChange()

    def on_selection_list_selected_changed(self, event: SelectionList.SelectedChanged) -> None:
        self.handleFileSelect()

    def on_text_area_changed(self, event: TextArea.Changed) -> None:
        self.handleNotesChange()

    def on_key(self, event: events.Key) -> None:
        self.handleFzfKeys()
        self.handleTableKeys()

    def handleDarkChange(self) -> None:
        pass  # TODO: implement

    def handleFileSelect(self) -> None:
        pass  # TODO: implement

    def handleFzfKeys(self) -> None:
        pass  # TODO: implement

    def handleNotesChange(self) -> None:
        pass  # TODO: implement

    def handleOk(self) -> None:
        pass  # TODO: implement

    def handleOptChange(self) -> None:
        pass  # TODO: implement

    def handleR1Change(self) -> None:
        pass  # TODO: implement

    def handleSearchChange(self) -> None:
        pass  # TODO: implement

    def handleSelChange(self) -> None:
        pass  # TODO: implement

    def handleTableKeys(self) -> None:
        pass  # TODO: implement


if __name__ == "__main__":
    MyApp().run()
"
`;

