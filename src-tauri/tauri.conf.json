{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Syndrid TUI Studio",
  "mainBinaryName": "syndrid-tui-studio",
  "version": "../package.json",
  "identifier": "com.syndrid.tuistudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Syndrid TUI Studio",
        "width": 1480,
        "height": 940,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "decorations": true,
        "theme": "Dark",
        "backgroundColor": "#090d12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "DeveloperTool",
    "publisher": "Syndrid",
    "copyright": "Copyright © 2026 Syndrid TUI Studio contributors",
    "shortDescription": "Visual Ratatui design studio for Syndrid CLI.",
    "longDescription": "Design responsive Ratatui interfaces, prototype states and motion, maintain reusable terminal UI components, and hand structured specifications to Codex and other MCP-compatible agents.",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "compression": "lzma",
        "installMode": "currentUser",
        "startMenuFolder": "Syndrid",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
